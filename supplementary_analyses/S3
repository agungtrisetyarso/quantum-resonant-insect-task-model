import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit

# ------------------- Damped Oscillator Model -------------------
def damped_oscillator(t, A0, omega, gamma, phi, C0):
    return A0 * np.exp(-gamma * t) * np.cos(omega * t + phi) + C0

# Base parameters from main IW colony
t = np.arange(0, 401, 1)
base_params = {'A0': 9.2, 'omega': 0.105, 'gamma': 0.017, 'phi': np.pi/4, 'C0': 14.0}

# ------------------- Generate Base + Scenarios -------------------
np.random.seed(42)

# 1. Original (Baseline)
y_base = damped_oscillator(t, **base_params)

# 2. Continuous Reskilling (Reduce damping γ by 40%)
params_reskill = base_params.copy()
params_reskill['gamma'] = base_params['gamma'] * 0.6
y_reskill = damped_oscillator(t, **params_reskill)

# 3. Strong External Perturbation (Increase initial amplitude)
params_perturb = base_params.copy()
params_perturb['A0'] = base_params['A0'] * 1.8
y_perturb = damped_oscillator(t, **params_perturb)

# ------------------- Plotting -------------------
fig, axes = plt.subplots(1, 3, figsize=(18, 6))
fig.suptitle('Supplementary Figure S3: Predictive Simulations Using Fitted Hybrid Model\n'
             'Effect of Reskilling and Strong Perturbations on Colony Activity', 
             fontsize=15, fontweight='bold')

# Plot 1: Reskilling
axes[0].plot(t, y_base, 'b-', lw=2, label='Original (γ = 0.017)')
axes[0].plot(t, y_reskill, 'g-', lw=2.5, label='Reskilling (γ reduced 40%)')
axes[0].set_title('Continuous Reskilling\n(Stabilization of Activity)')
axes[0].set_xlabel('Time (frames)')
axes[0].set_ylabel('RMSD (Activity Proxy)')
axes[0].legend()
axes[0].grid(True, alpha=0.3)

# Plot 2: Strong Perturbation
axes[1].plot(t, y_base, 'b-', lw=2, label='Original')
axes[1].plot(t, y_perturb, 'r-', lw=2.5, label='Strong Perturbation (A0 × 1.8)')
axes[1].set_title('Strong External Perturbation\n(Resonant Amplification)')
axes[1].set_xlabel('Time (frames)')
axes[1].set_ylabel('RMSD (Activity Proxy)')
axes[1].legend()
axes[1].grid(True, alpha=0.3)

# Plot 3: All Together
axes[2].plot(t, y_base, 'b-', lw=2, label='Baseline')
axes[2].plot(t, y_reskill, 'g-', lw=2.5, label='Reskilling')
axes[2].plot(t, y_perturb, 'r-', lw=2.5, label='Perturbation')
axes[2].set_title('Comparison of All Scenarios')
axes[2].set_xlabel('Time (frames)')
axes[2].set_ylabel('RMSD (Activity Proxy)')
axes[2].legend()
axes[2].grid(True, alpha=0.3)

plt.tight_layout(rect=[0, 0, 1, 0.92])
plt.show()

# Summary
print("Simulation Summary:")
print(f"Baseline damping γ          : {base_params['gamma']:.4f}")
print(f"Reskilling damping γ        : {params_reskill['gamma']:.4f}")
print(f"Perturbation initial A0     : {params_perturb['A0']:.2f}")
